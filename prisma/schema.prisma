// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "postgresql"
    
    //sync ke db supabase (dibutuhkan biar cepat, krna proses migrasi/sync itu berat)
    directUrl = env("DIRECT_URL") 

    // untuk query (fetch,insert,update,del), bagian yg terhubung ke db pooler/connection pooler(proses migrasi bisa lama)
    url = env("DATABASE_URL") 
}

// Di prisma, model adalah representasi dari tabel pada database.
model Category {
    id String @id @default(uuid())

    name String
    productCount Int @default(0)

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    //createdBy String // ID dari org yg bikin data
}